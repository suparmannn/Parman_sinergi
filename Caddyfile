# Railway sets PORT and terminates HTTPS, so Caddy listens on plain HTTP only.
:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	# shortcut: noindex keeps this preview domain out of search results. Remove it when the site goes live on sinergic.co.id.
	header X-Robots-Tag "noindex, nofollow"

	file_server

	handle_errors {
		rewrite * /{err.status_code}.html
		file_server
	}
}
